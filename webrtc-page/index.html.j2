<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WebRTC player</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; background: #000; overflow: hidden; }
    body { display: flex; }

    video {
      display: block;
      width: 100vw;
      height: 100vh;
      object-fit: contain;
      background: #000;
    }

    #status {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%) translateY(0);
      background: rgba(0,0,0,0.7);
      backdrop-filter: blur(8px);
      color: #ccc;
      font: 13px/1.4 system-ui, -apple-system, sans-serif;
      padding: 8px 20px;
      border-radius: 100px;
      border: 1px solid rgba(255,255,255,0.08);
      pointer-events: none;
      user-select: none;
      white-space: nowrap;
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    #status.error {
      color: #ff6b6b;
      border-color: rgba(255,107,107,0.25);
    }
  </style>
</head>
<body>

  <div id="status">Connecting…</div>
  <video id="video" autoplay playsinline controls></video>

  <script>
    (async () => {
      const video = document.getElementById('video');
      const status = document.getElementById('status');

      const stream = new URLSearchParams(location.search).get('stream');
      if (!stream) {
        status.textContent = 'No stream parameter provided';
        status.className = 'error';
        return;
      }

      document.title = stream + ' stream';

      let hideTimer;

      function showStatus(msg, cls) {
        status.textContent = msg;
        status.className = cls || '';
        status.style.opacity = '1';
        status.style.transform = 'translateX(-50%) translateY(0)';
        clearTimeout(hideTimer);
        hideTimer = setTimeout(() => {
          status.style.opacity = '0';
          status.style.transform = 'translateX(-50%) translateY(8px)';
        }, 5000);
      }

      try {
        const pc = new RTCPeerConnection();
        pc.ontrack = e => { video.srcObject = e.streams[0]; };
        pc.onconnectionstatechange = () => {
          showStatus(pc.connectionState === 'connected' ? 'Connected' : 'Connection: ' + pc.connectionState);
        };

        const offer = await pc.createOffer({ offerToReceiveAudio: true, offerToReceiveVideo: true });
        await pc.setLocalDescription(offer);
        showStatus('Negotiating…');

        const res = await fetch(`http://{{ domain }}:8889/${stream}/whep`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/sdp' },
          body: offer.sdp
        });
        if (!res.ok) throw new Error('WHEP request failed: ' + res.status);

        await pc.setRemoteDescription({ type: 'answer', sdp: await res.text() });
        showStatus('Connected');
      } catch (err) {
        console.error(err);
        showStatus(err.message, 'error');
      }
    })();
  </script>

</body>
</html>
