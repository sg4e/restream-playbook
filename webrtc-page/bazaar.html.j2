<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>SRS WebRTC WHEP Player - {{ grid_columns }}x{{ ((bazaar_streams | length) / (grid_columns | int)) | round(0, 'ceil') | int }} Grid</title>
  <style>
    body {
      margin: 0;
      background: #111;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      color: white;
      font-family: Arial, sans-serif;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat({{ grid_columns }}, 1fr);
      gap: 10px;
      width: 95vw;
      height: 95vh;
      padding: 10px;
    }
    .player-container {
      position: relative;
      background: black;
      border-radius: 8px;
      overflow: hidden;
    }
    video {
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: black;
    }
    .label {
      position: absolute;
      top: 10px;
      left: 10px;
      background: rgba(0, 0, 0, 0.7);
      color: white;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 14px;
      z-index: 10;
      pointer-events: none; /* Allows clicks to pass through to video controls */
    }
    .status {
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(0, 0, 0, 0.7);
      color: #aaa;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 12px;
      z-index: 10;
      pointer-events: none; /* Allows clicks to pass through to video controls */
    }
  </style>
</head>
<body>

  <div class="grid">
    {% for stream in bazaar_streams %}
    <div class="player-container">
      <div class="label">{{ stream }}</div>
      <div class="status" id="status-{{ stream }}">Connecting...</div>
      <video id="video-{{ stream }}" autoplay playsinline controls></video>
    </div>
    {% endfor %}
  </div>

  <script>
    const streams = {{ bazaar_streams | to_json }};

    async function startStream(streamName) {
      const video = document.getElementById(`video-${streamName}`);
      const statusDiv = document.getElementById(`status-${streamName}`);

      const whepUrl = `http://{{ domain }}:8889/${streamName}/whep`;

      try {
        const pc = new RTCPeerConnection();

        pc.ontrack = (event) => {
          video.srcObject = event.streams[0];
        };

        pc.onconnectionstatechange = () => {
          statusDiv.textContent = "State: " + pc.connectionState;
        };

        // Create offer
        const offer = await pc.createOffer({
          offerToReceiveAudio: true,
          offerToReceiveVideo: true
        });

        await pc.setLocalDescription(offer);

        // Send offer to WHEP endpoint
        const response = await fetch(whepUrl, {
          method: "POST",
          headers: {
            "Content-Type": "application/sdp"
          },
          body: offer.sdp
        });

        if (!response.ok) {
          throw new Error(`WHEP request failed: ${response.status}`);
        }

        const answerSdp = await response.text();

        await pc.setRemoteDescription({
          type: "answer",
          sdp: answerSdp
        });

        statusDiv.textContent = "Connected";
      } catch (err) {
        console.error(`Error for ${streamName}:`, err);
        statusDiv.textContent = "Error: " + err.message;
      }
    }

    // Start all streams
    streams.forEach(stream => startStream(stream));
  </script>

</body>
</html>
